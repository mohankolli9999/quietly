{
  "manifest_version": 3,
  "name": "Quietly",
  "version": "0.2.0",
  "description": "Mutes audio ads on the Spotify and Amazon Music web players. No host permissions, no tracking, no remote code.",
  "homepage_url": "https://github.com/mohankolli9999/quietly",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*", "https://music.amazon.com/*"],
      "js": ["src/shim.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://open.spotify.com/*", "https://music.amazon.com/*"],
      "js": ["src/bridge.js"],
      "css": ["src/indicator.css"],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
